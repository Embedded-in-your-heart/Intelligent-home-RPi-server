# Copy to .env and adjust. .env is gitignored.
# Taskfile.yml loads .env automatically; `uv run` does not — export manually
# (`set -a; source .env; set +a` on Linux) or invoke through `task ...`.

# Required when HOME_SERVER_DEBUG=0; in debug mode a random key is generated.
HOME_SERVER_SECRET_KEY=change-me-to-a-long-random-hex-string

# Where the SQLite file lives. Relative paths resolve from the project root.
HOME_SERVER_DB_PATH=./data/home.db

# HTTP server bind address and port.
HOME_SERVER_HOST=0.0.0.0
HOME_SERVER_PORT=5000

# Logging: DEBUG | INFO | WARNING | ERROR
HOME_SERVER_LOG_LEVEL=INFO

# BLE scan duration in seconds (default device discovery scan).
HOME_SERVER_BLE_SCAN_DURATION=5.0

# Per-channel minimum interval between DB writes for Notify-driven readings.
# UI push is not affected; this only throttles persistence.
HOME_SERVER_READING_MIN_INTERVAL=1.0

# Set to 1 to enable Flask debug mode and skip the SECRET_KEY requirement.
HOME_SERVER_DEBUG=0

# Bootstrap admin account, seeded once at startup if the username does not
# already exist (existing accounts are never modified). Leave ADMIN_PASSWORD
# empty to skip seeding entirely. Password must be >= 8 chars (the service
# enforces it, so a plain "admin" password is rejected).
HOME_SERVER_ADMIN_USERNAME=admin
HOME_SERVER_ADMIN_PASSWORD=
